# LiteLLM 공식 이미지(판본·다이제스트 고정)에 MINT를 설치한 이미지.
ARG LITELLM_IMAGE=ghcr.io/berriai/litellm-database@sha256:7ef0e78fe00ad5ea7ea45666cc1d1f02cb7076aee69091543bf397de52db33ce

FROM python:3.13-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1 AS build
COPY pyproject.toml README.md LICENSE /src/
COPY src /src/src
RUN pip wheel --no-deps --wheel-dir /wheels /src

FROM ${LITELLM_IMAGE}
# 정책 시험과 번들 준비에 쓰는 opa 실행 파일과 정책 소스. 정책 엔진 이미지와 같은 판본이다.
COPY --from=openpolicyagent/opa:1.21.4@sha256:12420358d3f22a0cd2424ddc44a16e292ecb42825d3dfbca779986006822a3f6 /opa /usr/local/bin/opa
COPY policy /opt/mint/policy
COPY --from=build /wheels /tmp/wheels
# uv.lock에서 내보낸 판본 제약. 설치할 패키지의 판본만 고정하며 기반 이미지의 litellm은 다시 설치하지 않는다.
COPY deploy/constraints.txt /tmp/constraints.txt
RUN python -m ensurepip \
    && python -m pip install -c /tmp/constraints.txt "$(ls /tmp/wheels/*.whl)[litellm]" \
    && python -m pip uninstall -y pip \
    && rm -rf /tmp/wheels /tmp/constraints.txt

# LiteLLM을 시작하기 전에 설정 파일을 검사하는 진입점. 검사에 실패하면 컨테이너가 시작되지 않는다.
COPY deploy/mint-entrypoint.sh /usr/local/bin/mint-entrypoint
RUN chmod +x /usr/local/bin/mint-entrypoint
ENTRYPOINT ["mint-entrypoint"]
CMD ["--port", "4000"]
