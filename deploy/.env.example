# 복사해서 .env로 쓴다. 모든 값을 배포 환경에 맞게 바꾼다.
POSTGRES_PASSWORD=change-me-postgres
MINT_PLUGIN_DB_PASSWORD=change-me-plugin
MINT_CONTROL_DB_PASSWORD=change-me-control
LITELLM_MASTER_KEY=sk-change-me-master

# 배치 식별자와 모드 상한(enforce면 저장 설정으로 observe로 낮출 수 없다)
MINT_INSTANCE_ID=default
MINT_MODE=enforce

# 제어 평면 LiteLLM 키(proxy_admin 사용자 키, allowed_routes 제한). init 출력의 안내대로 발급해 넣는다.
MINT_LITELLM_KEY=

# 외부에 공개하는 주소와 OAuth 리다이렉트 출처
PROXY_BASE_URL=
MCP_TRUSTED_REDIRECT_ORIGINS=

# 호스트에 공개하는 LiteLLM 포트
MINT_LITELLM_PORT=4000

# 복제본 수(둘 이상이면 공유 Redis 설정이 필요하다고 check가 경고한다)
MINT_REPLICAS=1
